@echo off
:: --- 0. Устанавливаем кодировку UTF-8 для правильного отображения кириллицы ---
chcp 65001 >nul

title Kaspi Donations Service

:: --- 1. Переходим в папку, где лежит этот .bat файл ---
cd /d "%~dp0"

echo [INFO] Установка или обновление необходимых библиотек...
pip install -r requirements.txt >nul

echo [INFO] Запуск веб-сервиса...
echo [INFO] Возможные ошибки при запуске будут записаны в файл error_log.txt
echo.

:: --- 2. Запускаем сервер ---
:: Стандартный вывод (лог Flask) будет в этом окне.
:: Ошибки при запуске (traceback) будут перенаправлены в файл error_log.txt
python server.py 2> error_log.txt

:: --- 3. Этот блок выполнится ТОЛЬКО ЕСЛИ python.exe завершится с ошибкой ---
:: Если сервер работает штатно, скрипт будет "висеть" на команде выше.
echo.
echo =================================================================
echo [ВНИМАНИЕ!] Процесс сервера неожиданно завершился.
echo Пожалуйста, проверьте файл error_log.txt на наличие ошибок.
echo =================================================================
pause

